# Copia este archivo como .env (que está en .gitignore) y ajusta los valores.
# NUNCA subas el .env con claves reales a un repositorio.

# --- Base de datos -------------------------------------------------------
# Siempre el rol de aplicación nexus360_app, nunca el dueño del esquema.
DATABASE_URL=postgresql://nexus360_app:dev_only_change_me@localhost:5432/nexus360

# --- CORS ----------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Análisis inteligente (Gemini) — opcional ----------------------------
GEMINI_API_KEY=

# --- reCAPTCHA v3 — opcional ---------------------------------------------
RECAPTCHA_SECRET_KEY=
# RECAPTCHA_SOLO_OBSERVAR=false

# --- Recuperación de contraseña por correo (013) -------------------------
# URL pública del FRONT: de aquí sale el enlace del correo. En producción,
# la de Vercel con https (p. ej. https://n360.vercel.app).
FRONTEND_URL=http://localhost:5173
RECUPERACION_MINUTOS=30

# Remitente de los correos.
CORREO_REMITENTE=no-responder@nexus360.local
CORREO_REMITENTE_NOMBRE=NEXUS 360°

# Opción A — desarrollo con Mailpit (docker compose up -d). Bandeja: http://localhost:8025
CORREO_PROVEEDOR=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SEGURIDAD=ninguna
SMTP_USUARIO=
SMTP_PASSWORD=

# Opción B — SMTP real (Gmail con «contraseña de aplicación», Brevo SMTP, etc.)
# CORREO_PROVEEDOR=smtp
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SEGURIDAD=starttls
# SMTP_USUARIO=tu-usuario-smtp
# SMTP_PASSWORD=tu-clave-smtp

# Opción C — API HTTPS de Brevo. Úsela si el hosting bloquea SMTP (Render gratis).
# CORREO_PROVEEDOR=brevo
# BREVO_API_KEY=xkeysib-...
# CORREO_REMITENTE=un-correo-verificado-en-brevo@tudominio.co
